# Copy to ".env" and fill in. Never commit the real file.

# Frontend origin(s) allowed by CORS (comma-separated) and where the Zoho
# OAuth callback sends the browser back to.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Gemini (optional: without a key, explanations/emails/chat fall back to
#    deterministic templates built from the same computed numbers) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Zoho Books ──
# One-time setup: api-console.zoho.in (or .com / .eu / ...) -> Add Client -> "Server-based Applications".
#   Authorized Redirect URI = ZOHO_REDIRECT_URI below. Users never enter these; they click Connect, log
#   in on Zoho and approve. The API data center is picked up automatically from Zoho's token response.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/auth/zoho/callback
# Login host of the data center your users sign in to (.com / .eu / .in / .com.au / .jp ...)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# ── Oracle NetSuite (OAuth 2.0 client-credentials / M2M, signed JWT) ──
# Integration record with "Client Credentials (M2M) Grant" ticked, scope REST Web Services.
# Upload the PUBLIC cert in Setup > Integration > OAuth 2.0 Client Credentials (M2M) Setup.
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_PRIVATE_KEY_PATH=./netsuite_private_key.pem
NETSUITE_JWT_ALG=PS256
